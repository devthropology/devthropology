# Repository and GitHub API details
REPO_OWNER=
REPO_NAME=
GH_USER=
GH_TOKEN=

# Raw GitHub archives: independent local retention and S3/R2 upload.
# Both false disables archival. S3-only still stages on disk until upload succeeds.
GH_ARCHIVE_LOCAL=false
GH_ARCHIVE_S3=false
# Relative paths resolve from the repository root, not the process cwd.
GH_ARCHIVE_DIR=./data
GH_ARCHIVE_LEVEL=6
GH_ARCHIVE_S3_BUCKET=
GH_ARCHIVE_PREFIX=gh_api_archive
GH_ARCHIVE_S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
GH_ARCHIVE_S3_ENDPOINT=
# Prefix can identify the source, e.g. gh_api_archive/local.
# Local alternative to keys: AWS_PROFILE=<profile> (uses ~/.aws/credentials).
# Runtime secrets only; never bake credentials into a Docker image.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DATABASE_URL_PG=postgres://postgres:postgres@localhost:5433/devthropology?sslmode=disable
# ^ becomes %5E
# @ becomes %40
# ! becomes %21
DATABASE_URL_PG_DBMATE=postgres://postgres:postgres@localhost:5433/devthropology?sslmode=disable
POSTGRES_PASSWORD_TEST="somesecretpassword"
AUTH_PASSWORD_PEPPER=
# Optional GitHub App user login (backend only; leave blank to disable).
# Client ID, NOT the numeric App ID. Never expose the client secret via VITE_*.
# Repository installation onboarding (backend only)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Local PEM file takes precedence over BASE64 when both are set.
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative for Railway: base64 of the entire PEM file (backend secret only).
# Generate with: base64 < /path/to/private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=
# Register /app/settings/github on the frontend origin as both the App Setup URL
# and an additional OAuth callback URL. Keep the existing login callback too.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Frontend origin + /auth/github/callback; must match GitHub App registration.
# Example: http://localhost:3001/auth/github/callback
GITHUB_APP_CALLBACK_URL=
ENABLE_DEMO_LOGIN=false
DEMO_USERNAME=
DEMO_PASSWORD=
PG_POOL_MAX=5
PG_POOL_IDLE_TIMEOUT=30
PG_POOL_MAX_LIFETIME=600
PG_CONNECT_TIMEOUT=3
# Optional dedicated pool for expensive author/reviewer report queries.
# If PG_REPORT_POOL_MAX is unset, reports use the main PG pool.
# PG_REPORT_POOL_MAX=5
# PG_REPORT_POOL_IDLE_TIMEOUT=30
# PG_REPORT_POOL_MAX_LIFETIME=600
# PG_REPORT_CONNECT_TIMEOUT=3
# Self-hosted frontend options; export when running start:prod.
# Reuses VITE_FRONTEND_PORT, VITE_BACKEND_PORT and VITE_BACKEND_API_URL below.
FRONTEND_HOST=localhost
ALLOW_INSECURE_LOCAL_HTTP=false
BACKEND_PORT=
VITE_BACKEND_PORT=
VITE_BACKEND_API_URL=
VITE_FRONTEND_PORT=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Frontend (not loaded from this file): export in the shell/service env,
# or set as an encrypted Cloudflare Pages secret. Required in production.
# Comma-separated for rotation; the first signs. Generate: openssl rand -base64 32
# SESSION_SECRET=
