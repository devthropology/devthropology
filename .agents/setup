#!/usr/bin/env bash
# Prepares a fresh Amp orb: Node dependencies, React Router types, a seeded
# local Postgres 17 dev database, and Docker with pre-pulled testcontainers
# images for backend tests.
set -euo pipefail

cd "$(dirname "$0")/.."

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

check_node() {
  local want have
  want="$(cat .node-version)"
  have="$(node --version | sed 's/^v//')"
  if [[ "${have%%.*}" != "${want%%.*}" ]]; then
    echo "Node $have does not match major version of .node-version ($want)" >&2
    exit 1
  fi
  echo "node $have (pinned $want)"
}

install_pnpm() {
  local want
  want="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
  if [[ "$(pnpm --version 2>/dev/null || true)" != "$want" ]]; then
    npm install -g "pnpm@$want"
  fi
  pnpm --version
}

install_deps() {
  CI=true pnpm install --frozen-lockfile
}

generate_frontend_types() {
  pnpm --filter @devthropology/frontend exec react-router typegen
}

setup_postgres() {
  if ! command -v pg_ctlcluster >/dev/null 2>&1; then
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends postgresql
  fi

  local pg_ver conf_file desired_conf
  pg_ver="$(pg_lsclusters -h | awk '{print $1; exit}')"
  conf_file="/etc/postgresql/${pg_ver}/main/conf.d/amp-orb.conf"
  desired_conf=$'port = 5433\nfsync = off\nsynchronous_commit = off\nfull_page_writes = off\n'

  if [[ ! -f "$conf_file" ]] || [[ "$(cat "$conf_file")"$'\n' != "$desired_conf" ]]; then
    printf '%s' "$desired_conf" | sudo tee "$conf_file" >/dev/null
    sudo systemctl restart postgresql
  else
    sudo systemctl start postgresql
  fi

  for _ in $(seq 1 20); do
    pg_isready -h 127.0.0.1 -p 5433 -q && break
    sleep 0.5
  done
  pg_isready -h 127.0.0.1 -p 5433 -q

  sudo -u postgres psql -p 5433 -v ON_ERROR_STOP=1 -c "ALTER USER postgres WITH PASSWORD 'postgres';" >/dev/null
  if ! sudo -u postgres psql -p 5433 -tAc "SELECT 1 FROM pg_database WHERE datname = 'devthropology'" | grep -qx 1; then
    sudo -u postgres createdb -p 5433 -O postgres devthropology
  fi
}

setup_env() {
  if [[ ! -f .env ]]; then
    cat > .env <<'EOF'
# Generated by .agents/setup for Amp orb local development
DATABASE_URL_PG=postgres://postgres:postgres@localhost:5433/devthropology?sslmode=disable
DATABASE_URL_PG_DBMATE=postgres://postgres:postgres@localhost:5433/devthropology?sslmode=disable
AUTH_PASSWORD_PEPPER=dev-orb-pepper-not-for-production
REPO_OWNER=tailscale
REPO_NAME=tailscale
ENABLE_DEMO_LOGIN=true
DEMO_USERNAME=dev
DEMO_PASSWORD=devpassword
EOF
  fi
}

migrate_and_seed() {
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a

  pnpm run db:migrate
  node --import tsx .agents/seedDevDb.ts

  if ! sudo -u postgres psql -p 5433 -d devthropology -tAc "SELECT 1 FROM auth_users WHERE username = 'dev'" | grep -qx 1; then
    pnpm cli auth create-user -u dev -p devpassword -r superuser
  fi

  sudo -u postgres psql -p 5433 -d devthropology -v ON_ERROR_STOP=1 -c "
    INSERT INTO workspace_member (workspace_id, auth_user_id, workspace_role)
    SELECT w.workspace_id, u.auth_user_id, 'owner'
    FROM workspace w
    JOIN auth_users u ON u.username = 'dev'
    WHERE w.slug = 'demo'
    ON CONFLICT (workspace_id, auth_user_id) DO NOTHING;
  " >/dev/null
}

start_docker() {
  # The Amp agent runs as `user`, which is not in the docker group and cannot
  # gain it without a new login, so hand the socket to `user` directly.
  local dropin=/etc/systemd/system/docker.socket.d/amp-user.conf
  if [[ ! -f "$dropin" ]]; then
    sudo mkdir -p "$(dirname "$dropin")"
    printf '[Socket]\nSocketUser=%s\nSocketMode=0660\n' "$(id -un)" | sudo tee "$dropin" >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl restart docker.socket docker
  fi
  sudo systemctl start docker
  for _ in $(seq 1 30); do
    docker info >/dev/null 2>&1 && return 0
    sleep 1
  done
  echo "Docker daemon did not start" >&2
  exit 1
}

pull_images() {
  # Images testcontainers starts in backend tests; pulling them here keeps
  # them in the orb snapshot so the first test run does not download them.
  local postgres ryuk
  postgres="$(grep -o 'PostgreSqlContainer("[^"]*")' backend/testUtils/testDatabase.ts | head -1 | cut -d'"' -f2 || true)"
  ryuk="$(grep -rhoE 'testcontainers/ryuk:[0-9.]+' node_modules/.pnpm/testcontainers@*/node_modules/testcontainers/build/reaper/ 2>/dev/null | sort -V | tail -1 || true)"
  for image in "${postgres:-postgres:17-alpine}" "$ryuk"; do
    [[ -n "$image" ]] || continue
    docker image inspect "$image" >/dev/null 2>&1 || docker pull --quiet "$image"
  done
}

write_orb_guidance() {
  local agents_file="$HOME/.config/amp/AGENTS.md"
  local marker="# Devthropology Orb Environment"
  mkdir -p "$(dirname "$agents_file")"
  if ! grep -Fqx "$marker" "$agents_file" 2>/dev/null; then
    cat >> "$agents_file" <<'EOF'

# Devthropology Orb Environment

- Start the dev stack (backend on 8000, frontend on 3000 with portal) with `amp orb services ensure`.
- Native Postgres 17 runs on `localhost:5433` (database `devthropology`, user/password `postgres`) pre-seeded with 500 `tailscale/tailscale` PRs.
- Local dev superuser account: username `dev`, password `devpassword` (Demo Login is also enabled).
- For UI verification in this orb, use `agent-browser` against the portal URL instead of the macOS Chrome CDP instructions in `AGENTS.md`.
EOF
  fi
}

step "Check Node version" check_node
step "Install pnpm" install_pnpm
step "Install dependencies" install_deps
step "Generate frontend types" generate_frontend_types
step "Configure Postgres" setup_postgres
step "Create local .env" setup_env
step "Migrate and seed dev DB" migrate_and_seed
step "Start Docker" start_docker
step "Pull test images" pull_images
step "Write orb guidance" write_orb_guidance
