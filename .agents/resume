#!/usr/bin/env bash
# Daemons do not survive the orb snapshot or pause; restart Postgres (dev DB)
# and Docker (testcontainers for backend tests) when the orb wakes.
set -euo pipefail

if ! pg_isready -h 127.0.0.1 -p 5433 -q 2>/dev/null; then
  sudo systemctl start postgresql
  for _ in $(seq 1 10); do
    pg_isready -h 127.0.0.1 -p 5433 -q && break
    sleep 0.5
  done
fi

if ! docker info >/dev/null 2>&1; then
  sudo systemctl start docker
  for _ in $(seq 1 10); do
    docker info >/dev/null 2>&1 && break
    sleep 0.5
  done
fi
