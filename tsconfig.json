{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "backend/**/*.ts",
    "shared/**/*.ts",
    "tools/nodeCompatibilitySmoke.ts",
    "tools/backfill-issue-types.ts",
    "tools/recompute-relationships.ts"
  ],
  "exclude": ["**/*.test.ts", "frontend", "node_modules"]
}
