FROM node:26-bookworm-slim
WORKDIR /app

ENV NODE_ENV=production
RUN npm install --global pnpm@12.10.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
RUN pnpm --filter devthropology --filter @devthropology/backend install --prod --frozen-lockfile
COPY --chown=node:node . .
RUN mkdir -p /data/github-archive && chown node:node /app /data/github-archive
# Mount persistent storage here; inject R2 credentials at runtime.
ENV GH_ARCHIVE_DIR=/data/github-archive

ENV PORT=8080
EXPOSE 8080
USER node

CMD ["node", "--import", "tsx", "backend/main.ts"]
