    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "jsdom": "^28.1.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.107.1"
