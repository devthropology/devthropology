{
  "name": "@devthropology/frontend",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "react-router build",
    "build:self-hosted": "SELF_HOSTED=true react-router build",
    "start:self-hosted": "NODE_ENV=production HOST=${FRONTEND_HOST:-localhost} PORT=${VITE_FRONTEND_PORT:-3000} react-router-serve ./build-self-hosted/server/index.js",
    "dev": "react-router dev",
    "lint": "oxlint .",
    "start": "wrangler pages dev ./build/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "pages:deploy": "pnpm run build && wrangler pages deploy ./build/client"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-router/cloudflare": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@react-sigma/core": "^5.0.6",
    "@sentry/cloudflare": "^10.38.0",
    "@sentry/core": "10.43.0",
    "@sentry/react": "^10.43.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "chart.js": "^4.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "isbot": "^4.1.0",
    "lucide-react": "^0.469.0",
    "react": "19.3.1",
    "react-aria-components": "^1.12.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "sigma": "^3.0.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
